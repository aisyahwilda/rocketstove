{
    "version": 2,
    "builds": [
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(css|js|images|storage)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/tentang-kami",
            "dest": "/public/tentang-kami/index.html"
        },
        {
            "src": "/rocket-stove",
            "dest": "/public/rocket-stove/index.html"
        },
        {
            "src": "/edukasi",
            "dest": "/public/edukasi/index.html"
        },
        {
            "src": "/dokumentasi",
            "dest": "/public/dokumentasi/index.html"
        },
        {
            "src": "/(.*)",
            "dest": "/public/index.html"
        }
    ]
}